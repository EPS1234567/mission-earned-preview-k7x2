# Mission Earned portal — environment.
#
# Generate each 32-byte secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Set these as SEALED variables in Railway. A sealed variable cannot be read
# back, so keep your own copy somewhere safe — see the warning on FILE_MASTER_KEY.

NODE_ENV=production

# The public URL this service is served from. Magic links are built from it and
# it is the origin cookies are locked to. No trailing slash.
APP_ORIGIN=https://app.missionearned.org

# Origins allowed to POST the public volunteer form. Comma separated.
# This is the marketing site, wherever it is hosted.
FORM_ORIGINS=https://missionearned.org,https://www.missionearned.org

# Railway Postgres. Use the private-network reference so traffic never leaves
# the project: in Railway set this to ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# --- Secrets. 32 bytes each, base64. -----------------------------------------

# Wraps every per-document encryption key.
# LOSING THIS MAKES EVERY STORED DOCUMENT PERMANENTLY UNREADABLE, including
# every DD-214 and signed agreement. Back it up outside Railway before launch.
FILE_MASTER_KEY=

# Peppers stored magic-link verifiers, so a database dump alone cannot mint a
# candidate session.
MAGICLINK_PEPPER=

# Signs CSRF tokens.
CSRF_HMAC_KEY=

# --- Document storage ---------------------------------------------------------

# "local" writes to a directory (use a Railway Volume mounted at STORAGE_DIR).
# "s3" uses any S3-compatible bucket and needs: npm install @aws-sdk/client-s3
STORAGE_DRIVER=local
STORAGE_DIR=/data/blobs

# Only when STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Largest document a candidate or staff member can send, in bytes.
# Keep well under Railway's 5-minute edge body timeout.
UPLOAD_MAX_BYTES=10485760

# --- Email --------------------------------------------------------------------
# Any SMTP provider. Without these the service still runs, but it records that
# notifications could not be sent rather than pretending they were.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Mission Earned <no-reply@missionearned.org>

# Who gets told when an application or a reply arrives. Comma separated.
STAFF_NOTIFY_EMAILS=

# --- Organisation -------------------------------------------------------------
ORG_PHONE=(833) 674-6387
ORG_EMAIL=info@missionearned.org

# Administrators must present a second factor. Set to false ONLY to recover a
# locked-out admin, then set it straight back.
REQUIRE_TOTP_FOR_ADMIN=true
